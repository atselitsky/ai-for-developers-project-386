{
  "name": "@ai-for-developers/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "yarn generate:api",
    "build": "vite build",
    "prebuild": "yarn generate:api",
    "preview": "vite preview",
    "test": "vitest",
    "pretest": "yarn generate:api",
    "test:coverage": "vitest run --coverage",
    "generate:api": "yarn workspace @ai-for-developers/typespec run build && openapi-typescript ../typespec/tsp-output/@typespec/openapi3/openapi.yaml -o src/api/schema.ts",
    "type-check": "vue-tsc --noEmit",
    "pretype-check": "yarn generate:api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "lint:styles": "stylelint \"src/**/*.{vue,css}\"",
    "lint:styles:fix": "stylelint \"src/**/*.{vue,css}\" --fix",
    "lint:all": "yarn type-check && yarn lint && yarn format:check && yarn lint:styles"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "3.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^26.0.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^16.26.1",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended": "^16.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "vue-eslint-parser": "^10.3.0",
    "vue-tsc": "^2.2.0"
  }
}
